# Скопируйте в .env и укажите СВОЙ пароль PostgreSQL
# Рабочая директория PyCharm для запуска: backend/

# Вариант 1 — стандартный пользователь postgres:
DATABASE_URL=postgresql+asyncpg://postgres:ВАШ_ПАРОЛЬ@localhost:5432/crm

# Вариант 2 — отдельный пользователь crm (создайте в pgAdmin / psql):
# DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=./uploads
TEMPLATES_DIR=./templates

# Ключ API с https://dadata.ru/ (банк по БИК, до 10 000 запросов/день бесплатно)
DADATA_API_KEY=

# Railway: DATABASE_URL подставляется из Postgres.
# CORS_ORIGINS=https://ваш-фронт.up.railway.app


# Исполнитель (один на все договоры). Генеральный директор = подписант (EXECUTOR_DIRECTOR / EXECUTOR_DIRECTOR_SIGN)
